#!/usr/bin/env bash
# Check that this machine can run the Atrium build orchestration (PLAN.md §8.7, §8.9).
# Run it on a new machine, and after upgrading any agent CLI.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
failed=0

check() { # <name> <command...>
  local name="$1"; shift
  local out
  if out="$("$@" 2>/dev/null | head -1)" && [[ -n "$out" ]]; then
    printf '  ✓ %-8s %s\n' "$name" "$out"
  else
    printf '  ✗ %-8s missing\n' "$name"
    failed=1
  fi
}

echo "Tools"
check git git --version
check gh gh --version
check claude claude --version
check codex codex --version
check agy agy --version
check cargo cargo --version
check node node --version
check pnpm pnpm --version
check python3 python3 --version

echo "Accounts"
if gh auth status >/dev/null 2>&1; then
  echo "  ✓ gh       logged in"
else
  echo "  ✗ gh       not logged in (run: gh auth login)"
  failed=1
fi
if gh repo view PedroI1S/atrium >/dev/null 2>&1; then
  echo "  ✓ repo     PedroI1S/atrium accessible"
else
  echo "  ✗ repo     no access to PedroI1S/atrium (ask Pedro to add you as a collaborator)"
  failed=1
fi

echo "agy worker policy (D-002, D-006)"
tested="1.4.7"
version="$(agy --version 2>/dev/null || true)"
if [[ "$version" != "$tested" ]]; then
  echo "  ! agy $version differs from the tested $tested: re-run the hook check in docs/agents/HANDOFF.md before dispatching agy workers"
fi
probe() { # <command line> <expected decision>
  printf '{"toolCall":{"name":"run_command","args":{"CommandLine":"%s"}},"workspacePaths":["/tmp"]}' "$1" |
    python3 -I scripts/agy-policy.py | grep -q "\"$2\""
}
if probe "git push origin main" deny && probe "cargo --version" allow; then
  echo "  ✓ policy   denies git push, allows cargo"
else
  echo "  ✗ policy   self-test failed (scripts/agy-policy.py)"
  failed=1
fi
if [[ -e .agents/hooks.json ]]; then
  echo "  ✗ .agents/hooks.json exists in the main checkout: the worker policy would apply to your own agy sessions (D-006)"
  failed=1
fi

echo
if [[ $failed -eq 0 ]]; then echo "All good."; else echo "Fix the ✗ items above."; fi
exit $failed
