#!/usr/bin/env bash
# Check that this machine can run the Atrium build orchestration (PLAN.md §8.7, §8.9).
# Run it on a new machine, and after upgrading any agent CLI.
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"
failed=0

check() { # <name> <command...>
  local name="$1"; shift
  local out
  if out="$("$@" 2>/dev/null | head -1)" && [[ -n "$out" ]]; then
    printf '  ✓ %-8s %s\n' "$name" "$out"
  else
    printf '  ✗ %-8s missing\n' "$name"
    failed=1
  fi
}

echo "Tools"
check git git --version
check gh gh --version
check claude claude --version
if command -v codex >/dev/null 2>&1; then
  check codex codex --version
else
  echo "  - codex    not installed (optional: Codex live work runs on a driver with a Codex login, D-047)"
fi
check agy agy --version
check cargo cargo --version
check node node --version
check pnpm pnpm --version
check python3 python3 --version

echo "Accounts"
if gh auth status >/dev/null 2>&1; then
  echo "  ✓ gh       logged in"
else
  echo "  ✗ gh       not logged in (run: gh auth login)"
  failed=1
fi
if gh repo view PedroI1S/atrium >/dev/null 2>&1; then
  echo "  ✓ repo     PedroI1S/atrium accessible"
else
  echo "  ✗ repo     no access to PedroI1S/atrium (ask Pedro to add you as a collaborator)"
  failed=1
fi

echo "Repo location (D-030, D-036)"
# Cloud-synced folders create conflict copies inside the tree and .git.
synced() { # <real path>
  case "$1" in
    "$HOME/Documents"/*|"$HOME/Desktop"/*|"$HOME/Library/Mobile Documents"/*|"$HOME/Library/CloudStorage"/*|*/Dropbox/*|*/OneDrive*/*|*"/Google Drive"/*) return 0 ;;
  esac
  return 1
}
gitdir="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"
# Worktrees live next to the main checkout (the .git's parent), wherever this runs.
wt="$(dirname "$(dirname "$gitdir")")/atrium-wt"
[[ -d "$wt" ]] && wt="$(cd "$wt" && pwd -P)"
paths_ok=1
for path in "$(pwd -P)" "$gitdir" "$wt"; do
  if synced "$path/"; then
    echo "  ✗ synced   $path is inside a cloud-synced folder: move the repo (README, Conventions)"
    failed=1 paths_ok=0
  fi
done
[[ $paths_ok -eq 1 ]] && echo "  ✓ paths    repo, .git and atrium-wt are outside synced folders"
if git fsck --connectivity-only --no-dangling >/dev/null 2>&1; then
  echo "  ✓ git      fsck (connectivity) passed"
else
  echo "  ✗ git      fsck failed: the repository is damaged"
  failed=1
fi
# iCloud-style conflict copies: "name 2.ext", "name 3" (tracked or not).
copies="$(find . \( -name target -o -name node_modules -o -name .git -o -name .orchestration \) -prune -o \
  \( -name '* [0-9]' -o -name '* [0-9].*' \) -print 2>/dev/null | head -5)"
if [[ -n "$copies" ]]; then
  echo "  ✗ copies   conflict copies found (first 5):"
  printf '%s\n' "$copies" | sed 's/^/      /'
  failed=1
else
  echo "  ✓ copies   no conflict copies in the tree"
fi

echo "agy worker policy (D-002, D-006)"
tested="1.5.3"
version="$(agy --version 2>/dev/null || true)"
if [[ "$version" != "$tested" ]]; then
  echo "  ! agy $version differs from the tested $tested: re-run the hook check in docs/agents/HANDOFF.md before dispatching agy workers"
fi
probe() { # <command line> <expected decision>
  printf '{"toolCall":{"name":"run_command","args":{"CommandLine":"%s"}},"workspacePaths":["/tmp"]}' "$1" |
    python3 -I scripts/agy-policy.py | grep -q "\"$2\""
}
if probe "git push origin main" deny && probe "cargo --version" allow; then
  echo "  ✓ policy   denies git push, allows cargo"
else
  echo "  ✗ policy   self-test failed (scripts/agy-policy.py)"
  failed=1
fi
if [[ -e .agents/hooks.json ]]; then
  echo "  ✗ .agents/hooks.json exists in the main checkout: the worker policy would apply to your own agy sessions (D-006)"
  failed=1
fi

echo
if [[ $failed -eq 0 ]]; then echo "All good."; else echo "Fix the ✗ items above."; fi
exit $failed
